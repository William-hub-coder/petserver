page {
  background: #f7f8fa;
  color: #1a1a2e;
  font-size: 28rpx;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
}

.card {
  margin: 24rpx;
  padding: 32rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.btn {
  margin-top: 24rpx;
  background: #1a9e8e;
  color: #fff;
  border-radius: 16rpx;
  font-weight: 500;
}

.btn-accent {
  margin-top: 24rpx;
  background: #ff8c5a;
  color: #fff;
  border-radius: 16rpx;
}

.nav {
  display: flex;
  gap: 16rpx;
  margin: 24rpx;
}

.nav navigator {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  background: #fff;
  border-radius: 999rpx;
  border: 1px solid #e5e7eb;
  color: #6b7280;
  font-size: 24rpx;
}

.trust {
  display: inline-block;
  background: linear-gradient(135deg, #d4a03a, #e6b85c);
  color: #fff;
  border-radius: 16rpx;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.sub {
  margin-top: 12rpx;
  color: #6b7280;
  font-size: 26rpx;
}
