# Infrastructure
# Local MVP: SQLite (relative to packages/db). Postgres when Docker is available:
# DATABASE_URL=postgresql://petpal:petpal@localhost:5432/petpal
DATABASE_URL=file:./dev.db
REDIS_URL=redis://localhost:6379
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=petpal
MINIO_SECRET_KEY=petpalsecret
MINIO_BUCKET=petpal-inspect

# Auth（生产务必更换 JWT_SECRET）
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=2h
REFRESH_EXPIRES_IN=30d
DEV_SMS_CODE=123456
AUTH_SMS_RATE_LIMIT=5

# Gateway 安全 / 性能
# 生产示例：GATEWAY_CORS_ORIGIN=https://app.example.com
GATEWAY_CORS_ORIGIN=
GATEWAY_RATE_LIMIT=300
GATEWAY_AUTH_RATE_LIMIT=20
GATEWAY_PROXY_TIMEOUT_MS=15000
GATEWAY_AGENT_TIMEOUT_MS=60000
NODE_ENV=development

# Service ports
GATEWAY_PORT=3000
AUTH_PORT=3001
USER_PORT=3002
MERCHANT_PORT=3003
INSPECT_PORT=3004
MESSAGE_PORT=3005
AGENT_GATEWAY_PORT=3006

# Downstream URLs (gateway / agent-gateway)
AUTH_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3002
MERCHANT_SERVICE_URL=http://localhost:3003
INSPECT_SERVICE_URL=http://localhost:3004
MESSAGE_SERVICE_URL=http://localhost:3005
AGENT_GATEWAY_URL=http://localhost:3006
ORCHESTRATOR_URL=http://localhost:8000
# agent-gateway → orchestrator
AGENT_ORCH_TIMEOUT_MS=55000
AGENT_ORCH_RETRIES=2
AGENT_CHAT_MAX_LEN=2000
AGENT_CHAT_RATE_LIMIT=30
# AGENT_CORS_ORIGIN=http://localhost:5175

# LLM — pluggable provider (deepseek | openai | openai_compat)
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=45
LLM_RETRIES=2

# 高德地图（JS Key 仅前端；Web 服务 Key 仅后端，勿写入前端）
AMAP_WEB_KEY=
VITE_AMAP_JS_KEY=
# JS API 2.0 若控制台开启了「安全密钥」，必须配置，否则地图空白并回退演示图层
VITE_AMAP_SECURITY_CODE=
# MVP：无真实骑手/服务者 App 时用模拟轨迹推进
LOCATION_TRACK_MOCK=true

# Client
VITE_API_BASE_URL=/api
